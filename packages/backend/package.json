{
  "name": "@flows/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/api/app.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"../analysis/src/**/*.ts\" \"../analysis/tests/**/*.ts\" \"../board/src/**/*.ts\" \"../board/tests/**/*.ts\" \"../core/src/**/*.ts\" \"../core/tests/**/*.ts\" \"../music/src/**/*.ts\" \"../music/tests/**/*.ts\" \"../shared/src/**/*.ts\" \"../flows/*/src/**/*.ts\" \"../flows/*/tests/**/*.ts\"",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"../analysis/src/**/*.ts\" \"../analysis/tests/**/*.ts\" \"../board/src/**/*.ts\" \"../board/tests/**/*.ts\" \"../core/src/**/*.ts\" \"../core/tests/**/*.ts\" \"../music/src/**/*.ts\" \"../music/tests/**/*.ts\" \"../shared/src/**/*.ts\" \"../flows/*/src/**/*.ts\" \"../flows/*/tests/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/static": "^1.4.10",
    "@flows/analysis": "workspace:*",
    "@flows/board": "workspace:*",
    "@flows/canvas": "workspace:*",
    "@flows/chat": "workspace:*",
    "@flows/core": "workspace:*",
    "@flows/lyrics": "workspace:*",
    "@flows/music": "workspace:*",
    "@flows/shared": "workspace:*",
    "@flows/spotify": "workspace:*",
    "@flows/trading": "workspace:*",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
