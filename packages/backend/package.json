{
    "name": "@flows/backend",
    "version": "0.1.0",
    "private": true,
    "type": "commonjs",
    "main": "./dist/api/app.js",
    "scripts": {
        "dev": "ts-node src/api/app.ts",
        "start": "ts-node src/cli/index.ts run",
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.4.0",
        "@elysiajs/node": "^1.4.2",
        "@elysiajs/static": "^1.4.7",
        "@flows/core": "workspace:*",
        "@flows/lyrics": "workspace:*",
        "@flows/shared": "workspace:*",
        "@flows/spotify": "workspace:*",
        "@flows/trading": "workspace:*",
        "dotenv": "^17.2.3",
        "elysia": "^1.4.18"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.19.1",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.48.1",
        "@typescript-eslint/parser": "^8.48.1",
        "@vitest/coverage-v8": "^4.0.15",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^15.9.0",
        "prettier": "^3.3.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.6.3",
        "vitest": "^4.0.15"
    }
}