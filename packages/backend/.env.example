# ===========================================
# BACKEND - Environment Configuration
# ===========================================

# -------------------------------------------
# Spotify Flow Configuration (Existing)
# -------------------------------------------
# Required for Spotify API Access
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Optional: Refresh Token (if using existing session)
# SPOTIFY_REFRESH_TOKEN=

# Pagination limit for Spotify fetches
SPOTIFY_PAGE_LIMIT=20

# App Server Configuration
SPOTIFY_FLOW_PORT=4173
SPOTIFY_FLOW_HOST=127.0.0.1

# Output directory for Spotify JSONs
# SPOTIFY_OUTPUT_DIR=./outputs/spotify

# ===========================================
# TRADING BOT FLOW - Environment Configuration
# ===========================================

# -------------------------------------------
# LLM Provider Configuration (Phase 3: Advisor)
# -------------------------------------------
# Select which LLM provider to use for the Trading Bot advisor
# Options: gemini, groq
# Default: gemini (Gemini 3 Flash)
LLM_PROVIDER=gemini

# Google Gemini API Key (required if LLM_PROVIDER=gemini)
# Model: gemini-3-flash (~$25/month with free tier, or $82 full cost)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (required if LLM_PROVIDER=groq)
# Model: llama-3.1-8b-instant (~$3.60/month, ultra-fast)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# -------------------------------------------
# Trading Configuration (Optional)
# -------------------------------------------
# Default trading pair to observe
TRADING_SYMBOL=BTCUSDT

# Default candle interval
TRADING_INTERVAL=1m

