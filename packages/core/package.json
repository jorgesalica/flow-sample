{
    "name": "@flows/core",
    "version": "0.1.0",
    "private": true,
    "type": "commonjs",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js"
        },
        "./llm": {
            "types": "./dist/llm/index.d.ts",
            "require": "./dist/llm/index.js"
        },
        "./logger": {
            "types": "./dist/logger.d.ts",
            "require": "./dist/logger.js"
        },
        "./cache": {
            "types": "./dist/cache.d.ts",
            "require": "./dist/cache.js"
        },
        "./db": {
            "types": "./dist/db/index.d.ts",
            "require": "./dist/db/index.js"
        },
        "./canvas": {
            "types": "./dist/canvas/index.d.ts",
            "require": "./dist/canvas/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@google/genai": "^1.39.0",
        "better-sqlite3": "^12.5.0",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.3",
        "zod": "^4.1.13",
        "zod-to-json-schema": "^3.25.2",
        "@flows/shared": "workspace:*"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.19.1",
        "typescript": "^5.6.3",
        "vitest": "^4.0.15"
    }
}
