{
  "name": "flow-sample",
  "version": "0.3.0",
  "private": true,
  "description": "Data flow playground - Spotify liked songs explorer with Elysia + SQLite backend",
  "author": "concienc.ia (jrsystems)",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @flows/shared run build",
    "test": "pnpm -r run --if-present test",
    "lint": "pnpm -r run --if-present lint",
    "check": "pnpm -r run --if-present check",
    "typecheck": "pnpm -r run --if-present typecheck",
    "format": "pnpm -r run --if-present format",
    "format:check": "pnpm -r run --if-present format:check",
    "clean": "rimraf packages/*/node_modules packages/*/dist node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "rimraf": "^6.0.1"
  }
}
