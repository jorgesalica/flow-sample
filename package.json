{
  "name": "flow-sample",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first analysis board for music, text, chat, canvas, and trading flows",
  "author": "concienc.ia (jrsystems)",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm clean:build && pnpm -r run build && pnpm check:runtime",
    "build:shared": "pnpm --filter @flows/shared run build",
    "test": "pnpm run test:tooling && pnpm -r run --if-present test",
    "test:tooling": "pnpm run test:architecture && pnpm run test:coverage-tooling && pnpm run test:runtime-tooling",
    "test:architecture": "node --test scripts/check-architecture-contracts.test.mjs",
    "test:coverage-tooling": "node --test scripts/run-coverage.test.mjs",
    "test:runtime-tooling": "node --test scripts/check-runtime-contracts.test.mjs",
    "test:coverage": "node scripts/run-coverage.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "lint": "pnpm -r run --if-present lint",
    "check": "pnpm -r run --if-present check",
    "typecheck": "pnpm -r run --if-present typecheck",
    "check:architecture": "node scripts/check-architecture-contracts.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:runtime": "node scripts/check-runtime-contracts.mjs",
    "check:runtime:manifests": "node scripts/check-runtime-contracts.mjs --manifests-only",
    "verify": "pnpm check:docs && pnpm check:architecture && pnpm check:runtime:manifests && pnpm lint && pnpm typecheck && pnpm check && pnpm test",
    "format": "pnpm -r run --if-present format",
    "format:check": "pnpm -r run --if-present format:check",
    "clean:build": "rimraf --glob \"packages/*/dist\" \"packages/flows/*/dist\" \"packages/ui/build\" \"packages/ui/.svelte-kit\"",
    "clean:artifacts": "pnpm clean:build && rimraf --glob \"packages/*/coverage\" \"packages/flows/*/coverage\" \"packages/ui/playwright-report\" \"packages/ui/test-results\"",
    "clean": "pnpm clean:artifacts && rimraf --glob \"packages/*/node_modules\" \"packages/flows/*/node_modules\" \"node_modules\"",
    "bootstrap": "pnpm install --frozen-lockfile && pnpm build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.24.0",
  "volta": {
    "node": "22.19.0"
  },
  "pnpm": {
    "overrides": {
      "file-type": "21.3.2"
    }
  },
  "dependencies": {
    "file-type": "21.3.2"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "rimraf": "^6.1.3"
  }
}
