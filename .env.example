# ============================================
# Server
# ============================================
PORT=4173
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# Spotify Flow
# ============================================
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional — if empty, connect via UI "Connect Spotify" button
# SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PAGE_LIMIT=5

# ============================================
# Trading Flow
# ============================================
TRADING_SYMBOL=BTCUSDT
TRADING_INTERVAL=1m
# Set to true to auto-enable the AI advisor on startup
ADVISOR_AUTO_START=false

# ============================================
# LLM (used by @flows/core for AI insights)
# ============================================
# Provider: gemini | groq | openrouter | cerebras | mistral | rotation
# "rotation" cycles through all configured free providers with round-robin + 429 fallback.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ── Provider API Keys ─────────────
# Only the key for your selected provider is required.
# For rotation mode, set keys for all providers you want included.
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
