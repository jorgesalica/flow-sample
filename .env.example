# Spotify API Credentials (Required for OAuth)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Spotify OAuth (Optional)
# If left empty, you can connect your account via the UI ("Connect Spotify" button).
# If provided, this usage acts as a manual override/legacy mode.
# SPOTIFY_REFRESH_TOKEN=

# App Configuration (Optional)
SPOTIFY_PAGE_LIMIT=20
SPOTIFY_FLOW_PORT=4173
SPOTIFY_FLOW_HOST=127.0.0.1
